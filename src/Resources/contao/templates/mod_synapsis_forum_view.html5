<?php
/*
 * Themenliste eines Forums (mit Unterforen und Seitennummerierung).
 *
 * @var array  $this->forum
 * @var array  $this->subforums
 * @var array  $this->topics
 * @var array  $this->breadcrumb
 * @var string $this->newTopicUrl
 * @var string $this->pagination
 */

use Contao\StringUtil;
use Contao\System;

$requestToken = System::getContainer()->get('contao.csrf.token_manager')->getDefaultTokenValue();
?>
<div class="synapsis<?= $this->schemeClass ?> synapsis-forumview<?= $this->class ?>"<?= $this->cssID ?>>

    <?php if (!empty($this->breadcrumb)): ?>
        <nav class="synapsis-breadcrumb">
            <?php foreach ($this->breadcrumb as $crumb): ?>
                <?php if ('' !== $crumb['url']): ?><a href="<?= $crumb['url'] ?>"><?= StringUtil::specialchars($crumb['title']) ?></a><?php else: ?><span><?= StringUtil::specialchars($crumb['title']) ?></span><?php endif; ?>
            <?php endforeach; ?>
        </nav>
    <?php endif; ?>

    <?php $this->insert('mod_synapsis_searchbox', $this->getData()); ?>

    <header class="synapsis-forumview__header">
        <div class="synapsis-forumview__heading">
            <h2 class="synapsis-forumview__title"><?= StringUtil::specialchars($this->forum['title']) ?></h2>
            <?php if (!empty($this->moderators)): ?>
                <p class="synapsis-forum-mods"><?= $GLOBALS['TL_LANG']['MSC']['synapsisModerators'] ?? 'Moderatoren' ?>: <?= StringUtil::specialchars(implode(', ', $this->moderators)) ?></p>
            <?php endif; ?>
        </div>
        <div class="synapsis-forumview__actions">
            <?php if ($this->canMarkRead): ?>
                <form action="<?= $this->markReadAction ?>" method="post" class="synapsis-markread">
                    <input type="hidden" name="FORM_SUBMIT" value="<?= $this->markReadFormId ?>">
                    <input type="hidden" name="REQUEST_TOKEN" value="<?= $requestToken ?>">
                    <input type="hidden" name="read_forum" value="<?= (int) $this->markReadForum ?>">
                    <button type="submit" class="synapsis-button"><?= $GLOBALS['TL_LANG']['MSC']['synapsisMarkForumRead'] ?? 'Forum als gelesen markieren' ?></button>
                </form>
            <?php endif; ?>
            <?php if ($this->canSubscribeForum): ?>
                <form action="<?= $this->forumSubscribeAction ?>" method="post" class="synapsis-subscribe">
                    <input type="hidden" name="FORM_SUBMIT" value="<?= $this->forumSubscribeFormId ?>">
                    <input type="hidden" name="REQUEST_TOKEN" value="<?= $requestToken ?>">
                    <button type="submit" class="synapsis-button<?= $this->isForumSubscribed ? ' synapsis-button--active' : '' ?>">
                        <?= $this->isForumSubscribed
                            ? ($GLOBALS['TL_LANG']['MSC']['synapsisForumUnsubscribe'] ?? 'Forum-Abo beenden')
                            : ($GLOBALS['TL_LANG']['MSC']['synapsisForumSubscribe'] ?? 'Forum abonnieren') ?>
                    </button>
                </form>
            <?php endif; ?>
            <?php if (!empty($this->feedUrl)): ?>
                <a class="synapsis-button synapsis-feedlink" href="<?= $this->feedUrl ?>" title="<?= $GLOBALS['TL_LANG']['MSC']['synapsisFeed'] ?? 'RSS-Feed' ?>">RSS</a>
            <?php endif; ?>
            <?php if ('' !== $this->newTopicUrl): ?>
                <a class="synapsis-button synapsis-button--primary" href="<?= $this->newTopicUrl ?>"><?= $GLOBALS['TL_LANG']['MSC']['synapsisNewTopic'] ?? 'Neues Thema' ?></a>
            <?php elseif ($this->closed): ?>
                <span class="synapsis-badge synapsis-badge--closed"><?= $GLOBALS['TL_LANG']['MSC']['synapsisClosed'] ?? 'Geschlossen' ?></span>
            <?php endif; ?>
        </div>
    </header>

    <?php if (!empty($this->subforums)): ?>
        <ul class="synapsis-forumlist">
            <?php foreach ($this->subforums as $forum): ?>
                <li class="synapsis-forumlist__row">
                    <span class="synapsis-col-forum">
                        <span class="synapsis-forum-icon<?= $forum['closed'] ? ' is-locked' : '' ?>"><?= $forum['iconSvg'] ?></span>
                        <span class="synapsis-forum-info">
                            <a class="synapsis-forum-title" href="<?= $forum['url'] ?>"><?= StringUtil::specialchars($forum['title']) ?></a>
                            <?php if ('' !== (string) $forum['description']): ?>
                                <span class="synapsis-forum-desc"><?= StringUtil::specialchars($forum['description']) ?></span>
                            <?php endif; ?>
                            <?php if (!empty($forum['moderators'])): ?>
                                <span class="synapsis-forum-mods"><?= $GLOBALS['TL_LANG']['MSC']['synapsisModerators'] ?? 'Moderatoren' ?>: <?= StringUtil::specialchars(implode(', ', $forum['moderators'])) ?></span>
                            <?php endif; ?>
                        </span>
                    </span>
                    <span class="synapsis-col-count"><?= $forum['topicCount'] ?></span>
                    <span class="synapsis-col-count"><?= $forum['postCount'] ?></span>
                    <span class="synapsis-col-last"></span>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php endif; ?>

    <?php if ($this->empty): ?>
        <p class="synapsis-empty"><?= $GLOBALS['TL_LANG']['MSC']['synapsisNoTopics'] ?? 'In diesem Forum gibt es noch keine Themen.' ?></p>
    <?php else: ?>
        <?php if (!empty($this->canBulk)): ?>
        <form action="<?= $this->bulkAction ?>" method="post" class="synapsis-bulkform">
            <input type="hidden" name="FORM_SUBMIT" value="<?= $this->bulkFormId ?>">
            <input type="hidden" name="REQUEST_TOKEN" value="<?= $requestToken ?>">
        <?php endif; ?>
        <ul class="synapsis-topiclist">
            <li class="synapsis-topiclist__head">
                <span class="synapsis-col-topic"><?= $GLOBALS['TL_LANG']['MSC']['synapsisTopic'] ?? 'Thema' ?></span>
                <span class="synapsis-col-count"><?= $GLOBALS['TL_LANG']['MSC']['synapsisReplies'] ?? 'Antworten' ?></span>
                <span class="synapsis-col-count"><?= $GLOBALS['TL_LANG']['MSC']['synapsisViews'] ?? 'Ansichten' ?></span>
                <span class="synapsis-col-last"><?= $GLOBALS['TL_LANG']['MSC']['synapsisLastPost'] ?? 'Letzter Beitrag' ?></span>
            </li>
            <?php foreach ($this->topics as $topic): ?>
                <li class="synapsis-topiclist__row<?= $topic['sticky'] ? ' is-sticky' : '' ?><?= !empty($topic['unread']) ? ' is-unread' : '' ?>">
                    <span class="synapsis-col-topic">
                        <?php if (!empty($this->canBulk)): ?><input type="checkbox" class="synapsis-bulk-check" name="bulk_topics[]" value="<?= (int) $topic['id'] ?>" title="<?= $GLOBALS['TL_LANG']['MSC']['synapsisBulkSelect'] ?? 'Für Massen-Moderation auswählen' ?>"><?php endif; ?>
                        <?php if (!empty($topic['unread'])): ?><span class="synapsis-unread-dot" title="<?= $GLOBALS['TL_LANG']['MSC']['synapsisUnread'] ?? 'Ungelesen' ?>"></span><?php endif; ?>
                        <?php if ($topic['sticky']): ?><span class="synapsis-badge synapsis-badge--sticky"><?= $GLOBALS['TL_LANG']['MSC']['synapsisSticky'] ?? 'Angeheftet' ?></span><?php endif; ?>
                        <?php if ($topic['locked']): ?><span class="synapsis-badge synapsis-badge--locked"><?= $GLOBALS['TL_LANG']['MSC']['synapsisLocked'] ?? 'Geschlossen' ?></span><?php endif; ?>
                        <a class="synapsis-topic-title" href="<?= $topic['url'] ?>"><?= StringUtil::specialchars($topic['title']) ?></a>
                        <span class="synapsis-topic-meta"><?= $topic['authorName'] ?> &middot; <?= $topic['dateFormatted'] ?></span>
                    </span>
                    <span class="synapsis-col-count"><?= $topic['replyCount'] ?></span>
                    <span class="synapsis-col-count"><?= $topic['views'] ?></span>
                    <span class="synapsis-col-last">
                        <?php if ($topic['lastPost']): ?>
                            <span class="synapsis-lastpost-meta"><?= $topic['lastPost']['authorName'] ?><br><?= $topic['lastPost']['dateFormatted'] ?></span>
                        <?php else: ?>
                            <span class="synapsis-lastpost-empty">&ndash;</span>
                        <?php endif; ?>
                    </span>
                </li>
            <?php endforeach; ?>
        </ul>

        <?php if (!empty($this->canBulk)): ?>
            <div class="synapsis-bulkbar">
                <span class="synapsis-bulkbar__label"><?= $GLOBALS['TL_LANG']['MSC']['synapsisBulkWithSelection'] ?? 'Mit Auswahl:' ?></span>
                <select name="bulk_action" class="synapsis-bulkbar__action">
                    <option value="">&ndash; <?= $GLOBALS['TL_LANG']['MSC']['synapsisBulkAction'] ?? 'Aktion wählen' ?> &ndash;</option>
                    <?php if (!empty($this->canBulkLock)): ?>
                        <option value="lock"><?= $GLOBALS['TL_LANG']['MSC']['synapsisBulkLock'] ?? 'Schließen' ?></option>
                        <option value="unlock"><?= $GLOBALS['TL_LANG']['MSC']['synapsisBulkUnlock'] ?? 'Öffnen' ?></option>
                    <?php endif; ?>
                    <?php if (!empty($this->canBulkMove) && !empty($this->bulkTargets)): ?>
                        <option value="move"><?= $GLOBALS['TL_LANG']['MSC']['synapsisBulkMove'] ?? 'Verschieben' ?></option>
                    <?php endif; ?>
                    <?php if (!empty($this->canBulkDelete)): ?>
                        <option value="delete"><?= $GLOBALS['TL_LANG']['MSC']['synapsisBulkDelete'] ?? 'Löschen' ?></option>
                    <?php endif; ?>
                </select>
                <?php if (!empty($this->canBulkMove) && !empty($this->bulkTargets)): ?>
                    <select name="bulk_target" class="synapsis-bulkbar__target">
                        <option value=""><?= $GLOBALS['TL_LANG']['MSC']['synapsisMoveTo'] ?? 'Verschieben nach …' ?></option>
                        <?php foreach ($this->bulkTargets as $target): ?>
                            <option value="<?= $target['id'] ?>"><?= StringUtil::specialchars($target['title']) ?></option>
                        <?php endforeach; ?>
                    </select>
                <?php endif; ?>
                <button type="submit" class="synapsis-button synapsis-button--secondary"><?= $GLOBALS['TL_LANG']['MSC']['synapsisBulkApply'] ?? 'Anwenden' ?></button>
            </div>
        </form>
        <?php endif; ?>

        <?= $this->pagination ?>
    <?php endif; ?>

    <p class="synapsis-back"><a href="<?= $this->baseUrl ?>">&laquo; <?= $GLOBALS['TL_LANG']['MSC']['synapsisBackToForum'] ?? 'Zur Übersicht' ?></a></p>

    <?php $this->insert('mod_synapsis_membernav', $this->getData()); ?>

</div>
