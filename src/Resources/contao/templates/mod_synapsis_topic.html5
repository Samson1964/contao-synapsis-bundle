<?php
/*
 * Beitraege eines Themas samt Antwortformular.
 *
 * @var array  $this->topic
 * @var array  $this->forum
 * @var array  $this->posts
 * @var array  $this->breadcrumb
 * @var string $this->pagination
 * @var bool   $this->canReply
 * @var bool   $this->editor
 */

use Contao\StringUtil;
use Contao\System;

$requestToken = System::getContainer()->get('contao.csrf.token_manager')->getDefaultTokenValue();
?>
<div class="synapsis<?= $this->schemeClass ?> synapsis-topic<?= $this->class ?>"<?= $this->cssID ?>>

    <?php if (!empty($this->breadcrumb)): ?>
        <nav class="synapsis-breadcrumb">
            <?php foreach ($this->breadcrumb as $crumb): ?>
                <?php if ('' !== $crumb['url']): ?><a href="<?= $crumb['url'] ?>"><?= StringUtil::specialchars($crumb['title']) ?></a><?php else: ?><span><?= StringUtil::specialchars($crumb['title']) ?></span><?php endif; ?>
            <?php endforeach; ?>
        </nav>
    <?php endif; ?>

    <?php $this->insert('mod_synapsis_searchbox', $this->getData()); ?>

    <header class="synapsis-topic__header">
        <h2 class="synapsis-topic__title"><?= StringUtil::specialchars($this->topic['title']) ?></h2>
        <div class="synapsis-topic__actions">
            <?php if ($this->isPinned): ?><span class="synapsis-badge synapsis-badge--sticky"><?= $GLOBALS['TL_LANG']['MSC']['synapsisPinned'] ?? 'Angepinnt' ?></span><?php endif; ?>
            <?php if ($this->locked): ?><span class="synapsis-badge synapsis-badge--locked"><?= $GLOBALS['TL_LANG']['MSC']['synapsisLocked'] ?? 'Geschlossen' ?></span><?php endif; ?>
            <?php if ($this->canPin): ?>
                <form action="<?= $this->pinAction ?>" method="post" class="synapsis-pin">
                    <input type="hidden" name="FORM_SUBMIT" value="<?= $this->pinFormId ?>">
                    <input type="hidden" name="REQUEST_TOKEN" value="<?= $requestToken ?>">
                    <button type="submit" class="synapsis-button<?= $this->isPinned ? ' synapsis-button--active' : '' ?>">
                        <?= $this->isPinned
                            ? ($GLOBALS['TL_LANG']['MSC']['synapsisUnpin'] ?? 'Nicht mehr anpinnen')
                            : ($GLOBALS['TL_LANG']['MSC']['synapsisPin'] ?? 'Oben anpinnen') ?>
                    </button>
                </form>
            <?php endif; ?>
            <?php if ($this->canLock): ?>
                <form action="<?= $this->moderateAction ?>" method="post" class="synapsis-pin">
                    <input type="hidden" name="FORM_SUBMIT" value="<?= $this->lockFormId ?>">
                    <input type="hidden" name="REQUEST_TOKEN" value="<?= $requestToken ?>">
                    <button type="submit" class="synapsis-button<?= $this->locked ? ' synapsis-button--active' : '' ?>">
                        <?= $this->locked
                            ? ($GLOBALS['TL_LANG']['MSC']['synapsisReopen'] ?? 'Wieder öffnen')
                            : ($GLOBALS['TL_LANG']['MSC']['synapsisClose'] ?? 'Thema schließen') ?>
                    </button>
                </form>
            <?php endif; ?>
            <?php if ($this->canMove && !empty($this->moveTargets)): ?>
                <form action="<?= $this->moderateAction ?>" method="post" class="synapsis-move">
                    <input type="hidden" name="FORM_SUBMIT" value="<?= $this->moveFormId ?>">
                    <input type="hidden" name="REQUEST_TOKEN" value="<?= $requestToken ?>">
                    <select name="move_target" class="synapsis-move__select" aria-label="<?= $GLOBALS['TL_LANG']['MSC']['synapsisMoveTo'] ?? 'Verschieben nach' ?>">
                        <option value=""><?= $GLOBALS['TL_LANG']['MSC']['synapsisMoveTo'] ?? 'Verschieben nach …' ?></option>
                        <?php foreach ($this->moveTargets as $target): ?>
                            <option value="<?= $target['id'] ?>"><?= StringUtil::specialchars($target['title']) ?></option>
                        <?php endforeach; ?>
                    </select>
                    <button type="submit" class="synapsis-button"><?= $GLOBALS['TL_LANG']['MSC']['synapsisMove'] ?? 'Verschieben' ?></button>
                </form>
            <?php endif; ?>
            <?php if ($this->canSubscribe): ?>
                <form action="<?= $this->subscribeAction ?>" method="post" class="synapsis-subscribe">
                    <input type="hidden" name="FORM_SUBMIT" value="<?= $this->subscribeFormId ?>">
                    <input type="hidden" name="REQUEST_TOKEN" value="<?= $requestToken ?>">
                    <button type="submit" class="synapsis-button<?= $this->isSubscribed ? ' synapsis-button--active' : '' ?>">
                        <?= $this->isSubscribed
                            ? ($GLOBALS['TL_LANG']['MSC']['synapsisUnsubscribe'] ?? 'Abo beenden')
                            : ($GLOBALS['TL_LANG']['MSC']['synapsisSubscribe'] ?? 'Thema abonnieren') ?>
                    </button>
                </form>
            <?php endif; ?>
        </div>
    </header>

    <?php if ($this->poll): ?>
        <section class="synapsis-poll">
            <h3 class="synapsis-poll__question"><?= StringUtil::specialchars($this->poll['question']) ?></h3>

            <?php if ('' !== $this->poll['closeLabel']): ?>
                <p class="synapsis-poll__deadline">
                    <?php if ($this->poll['ended']): ?>
                        <?= sprintf($GLOBALS['TL_LANG']['MSC']['synapsisPollEnded'] ?? 'Umfrage beendet am %s.', $this->poll['closeLabel']) ?>
                    <?php else: ?>
                        <?= sprintf($GLOBALS['TL_LANG']['MSC']['synapsisPollRunning'] ?? 'Abstimmen bis %s.', $this->poll['closeLabel']) ?>
                    <?php endif; ?>
                </p>
            <?php endif; ?>

            <?php if ($this->poll['canVote']): ?>
                <form action="<?= $this->poll['action'] ?>" method="post" class="synapsis-poll__form">
                    <input type="hidden" name="FORM_SUBMIT" value="<?= $this->poll['formId'] ?>">
                    <input type="hidden" name="REQUEST_TOKEN" value="<?= $requestToken ?>">
                    <?php foreach ($this->poll['options'] as $opt): ?>
                        <label class="synapsis-poll__option">
                            <input type="<?= $this->poll['multiple'] ? 'checkbox' : 'radio' ?>" name="poll_choice<?= $this->poll['multiple'] ? '[]' : '' ?>" value="<?= $opt['id'] ?>"<?= $this->poll['multiple'] ? '' : ' required' ?>>
                            <span><?= StringUtil::specialchars($opt['label']) ?></span>
                        </label>
                    <?php endforeach; ?>
                    <button type="submit" class="synapsis-button synapsis-button--primary"><?= $GLOBALS['TL_LANG']['MSC']['synapsisPollVote'] ?? 'Abstimmen' ?></button>
                </form>
            <?php elseif ($this->poll['showResults']): ?>
                <ul class="synapsis-poll__results">
                    <?php foreach ($this->poll['options'] as $opt): ?>
                        <li class="synapsis-poll__result">
                            <span class="synapsis-poll__label"><?= StringUtil::specialchars($opt['label']) ?></span>
                            <span class="synapsis-poll__bar"><span class="synapsis-poll__fill" style="width:<?= $opt['percent'] ?>%"></span></span>
                            <span class="synapsis-poll__count"><?= $opt['votes'] ?> (<?= $opt['percent'] ?>&#37;)</span>
                        </li>
                    <?php endforeach; ?>
                </ul>
                <p class="synapsis-poll__total"><?= sprintf($GLOBALS['TL_LANG']['MSC']['synapsisPollTotal'] ?? '%d Teilnehmer', (int) $this->poll['total']) ?></p>
            <?php else: ?>
                <p class="synapsis-poll__pending"><?= $GLOBALS['TL_LANG']['MSC']['synapsisPollPending'] ?? 'Die Ergebnisse werden nach dem Umfrageende angezeigt.' ?></p>
            <?php endif; ?>
        </section>
    <?php endif; ?>

    <?php if ($this->editPost): ?>
        <form action="<?= $this->editPost['action'] ?>" method="post" enctype="multipart/form-data" class="synapsis-form synapsis-editform">
            <input type="hidden" name="FORM_SUBMIT" value="<?= $this->editPost['formId'] ?>">
            <input type="hidden" name="REQUEST_TOKEN" value="<?= $requestToken ?>">
            <input type="hidden" name="post" value="<?= $this->editPost['id'] ?>">
            <h3 class="synapsis-form__label"><?= $GLOBALS['TL_LANG']['MSC']['synapsisEditPost'] ?? 'Beitrag bearbeiten' ?></h3>
            <textarea name="text" class="<?= $this->editor ? 'synapsis-editor' : '' ?>" rows="8"><?= StringUtil::specialchars($this->editPost['text']) ?></textarea>
            <?php if (!empty($this->emoticons)): ?>
                <div class="synapsis-smileys">
                    <?php foreach ($this->emoticons as $emo): ?><button type="button" class="synapsis-smiley" data-emoji="<?= $emo ?>" title="Smiley einfügen"><?= $emo ?></button><?php endforeach; ?>
                </div>
            <?php endif; ?>
            <div class="synapsis-form__actions">
                <button type="submit" class="synapsis-button synapsis-button--primary"><?= $GLOBALS['TL_LANG']['MSC']['synapsisSave'] ?? 'Speichern' ?></button>
                <a class="synapsis-button" href="<?= $this->editPost['cancelUrl'] ?>"><?= $GLOBALS['TL_LANG']['MSC']['synapsisCancel'] ?? 'Abbrechen' ?></a>
            </div>
        </form>
    <?php endif; ?>

    <?php if ($this->reportPost): ?>
        <form action="<?= $this->reportPost['action'] ?>" method="post" class="synapsis-form synapsis-reportform">
            <input type="hidden" name="FORM_SUBMIT" value="<?= $this->reportFormId ?>">
            <input type="hidden" name="REQUEST_TOKEN" value="<?= $requestToken ?>">
            <input type="hidden" name="post" value="<?= $this->reportPost['id'] ?>">
            <h3 class="synapsis-form__label"><?= $GLOBALS['TL_LANG']['MSC']['synapsisReport'] ?? 'Beitrag melden' ?></h3>
            <p class="synapsis-form__hint"><?= $GLOBALS['TL_LANG']['MSC']['synapsisReportHint'] ?? 'Bitte beschreibe kurz, warum dieser Beitrag gemeldet wird. Die Moderation prüft die Meldung.' ?></p>
            <textarea name="reason" rows="4" placeholder="<?= StringUtil::specialchars($GLOBALS['TL_LANG']['MSC']['synapsisReportReason'] ?? 'Grund der Meldung') ?>"></textarea>
            <div class="synapsis-form__actions">
                <button type="submit" class="synapsis-button synapsis-button--primary"><?= $GLOBALS['TL_LANG']['MSC']['synapsisReportSubmit'] ?? 'Meldung absenden' ?></button>
                <a class="synapsis-button" href="<?= $this->reportPost['cancelUrl'] ?>"><?= $GLOBALS['TL_LANG']['MSC']['synapsisCancel'] ?? 'Abbrechen' ?></a>
            </div>
        </form>
    <?php endif; ?>

    <div class="synapsis-posts">
        <?php foreach ($this->posts as $post): ?>
            <article class="synapsis-post" id="post-<?= $post['id'] ?>">
                <aside class="synapsis-post__author">
                    <?php if (!empty($post['authorUrl'])): ?>
                        <a class="synapsis-post__authorlink" href="<?= $post['authorUrl'] ?>"><?= $post['authorAvatar'] ?><span class="synapsis-post__authorname"><?= $post['authorName'] ?></span></a>
                    <?php else: ?>
                        <?= $post['authorAvatar'] ?>
                        <span class="synapsis-post__authorname"><?= $post['authorName'] ?></span>
                    <?php endif; ?>
                    <?php if (!empty($post['authorRank'])): ?>
                        <span class="synapsis-post__authorrank"><?= StringUtil::specialchars($post['authorRank']) ?></span>
                    <?php endif; ?>
                    <span class="synapsis-post__authormeta"><?= $GLOBALS['TL_LANG']['MSC']['synapsisPosts'] ?? 'Beiträge' ?>: <?= $post['authorPostCount'] ?></span>
                </aside>
                <div class="synapsis-post__body">
                    <div class="synapsis-post__date"><?= $post['dateFormatted'] ?></div>
                    <div class="synapsis-post__text"><?= $post['text'] ?></div>

                    <?php if (!empty($post['attachmentList'])): ?>
                        <div class="synapsis-post__attachments">
                            <?php foreach ($post['attachmentList'] as $attachment): ?>
                                <?php if ($attachment['isImage']): ?>
                                    <a class="synapsis-attachment synapsis-attachment--image" href="<?= $attachment['path'] ?>">
                                        <img src="<?= $attachment['path'] ?>" alt="<?= StringUtil::specialchars($attachment['name']) ?>" loading="lazy">
                                    </a>
                                <?php else: ?>
                                    <a class="synapsis-attachment synapsis-attachment--file" href="<?= $attachment['path'] ?>" target="_blank" rel="noreferrer noopener"><?= StringUtil::specialchars($attachment['name']) ?></a>
                                <?php endif; ?>
                            <?php endforeach; ?>
                        </div>
                    <?php endif; ?>

                    <?php if (!empty($post['editedLabel'])): ?>
                        <div class="synapsis-post__edited"><?= StringUtil::specialchars($post['editedLabel']) ?></div>
                    <?php endif; ?>

                    <?php if (!empty($post['signature'])): ?>
                        <div class="synapsis-post__signature"><?= $post['signature'] ?></div>
                    <?php endif; ?>

                    <div class="synapsis-post__footer">
                        <a class="synapsis-post__action synapsis-permalink" href="<?= $post['permalinkUrl'] ?>" data-permalink title="<?= $GLOBALS['TL_LANG']['MSC']['synapsisPermalinkCopy'] ?? 'Link kopieren' ?>"><?= $GLOBALS['TL_LANG']['MSC']['synapsisPermalink'] ?? 'Link' ?></a>
                        <?php if ($this->canReply): ?>
                            <a class="synapsis-post__action" href="<?= $post['quoteUrl'] ?>#synapsis-reply"><?= $GLOBALS['TL_LANG']['MSC']['synapsisQuote'] ?? 'Zitieren' ?></a>
                        <?php endif; ?>
                        <?php if (!empty($post['canReport'])): ?>
                            <a class="synapsis-post__action" href="<?= $post['reportUrl'] ?>"><?= $GLOBALS['TL_LANG']['MSC']['synapsisReport'] ?? 'Melden' ?></a>
                        <?php endif; ?>
                        <?php if (!empty($post['canModify'])): ?>
                            <a class="synapsis-post__action" href="<?= $post['editUrl'] ?>"><?= $GLOBALS['TL_LANG']['MSC']['synapsisEdit'] ?? 'Bearbeiten' ?></a>
                            <form action="<?= $this->moderateAction ?>" method="post" class="synapsis-post__delete" onsubmit="return confirm('<?= $GLOBALS['TL_LANG']['MSC']['synapsisDeleteConfirm'] ?? 'Diesen Beitrag wirklich löschen?' ?>');">
                                <input type="hidden" name="FORM_SUBMIT" value="<?= $this->deleteFormId ?>">
                                <input type="hidden" name="REQUEST_TOKEN" value="<?= $requestToken ?>">
                                <input type="hidden" name="post" value="<?= $post['id'] ?>">
                                <button type="submit" class="synapsis-post__action synapsis-post__action--danger"><?= $GLOBALS['TL_LANG']['MSC']['synapsisDelete'] ?? 'Löschen' ?></button>
                            </form>
                        <?php endif; ?>
                        <?php if (!empty($post['canBan'])): ?>
                            <form action="<?= $this->moderateAction ?>" method="post" class="synapsis-post__ban" onsubmit="return confirm('<?= $GLOBALS['TL_LANG']['MSC']['synapsisBanConfirm'] ?? 'Dieses Mitglied wirklich für das Forum sperren?' ?>');">
                                <input type="hidden" name="FORM_SUBMIT" value="<?= $this->banFormId ?>">
                                <input type="hidden" name="REQUEST_TOKEN" value="<?= $requestToken ?>">
                                <input type="hidden" name="ban_member" value="<?= (int) $post['author'] ?>">
                                <button type="submit" class="synapsis-post__action synapsis-post__action--danger"><?= $GLOBALS['TL_LANG']['MSC']['synapsisBan'] ?? 'Sperren' ?></button>
                            </form>
                        <?php endif; ?>
                        <?php if (!empty($post['canLike'])): ?>
                            <form action="<?= $this->likeAction ?>" method="post" class="synapsis-like__form">
                                <input type="hidden" name="FORM_SUBMIT" value="<?= $this->likeFormId ?>">
                                <input type="hidden" name="REQUEST_TOKEN" value="<?= $requestToken ?>">
                                <input type="hidden" name="post" value="<?= $post['id'] ?>">
                                <button type="submit" class="synapsis-like__button<?= !empty($post['likedByMe']) ? ' is-active' : '' ?>">
                                    <?php if (!empty($post['likedByMe'])): ?>
                                        &#10084; <?= $GLOBALS['TL_LANG']['MSC']['synapsisUnlike'] ?? 'Gefällt mir nicht mehr' ?>
                                    <?php else: ?>
                                        &#9825; <?= $GLOBALS['TL_LANG']['MSC']['synapsisLike'] ?? 'Gefällt mir' ?>
                                    <?php endif; ?>
                                </button>
                            </form>
                        <?php endif; ?>

                        <?php if ($post['likeCount'] > 0): ?>
                            <span class="synapsis-like__count">
                                &#10084; <?= $post['likeCount'] ?>
                                <?php if (!empty($post['likers'])): ?>
                                    <span class="synapsis-like__names">&middot; <?= StringUtil::specialchars(implode(', ', $post['likers'])) ?></span>
                                <?php endif; ?>
                            </span>
                        <?php endif; ?>
                    </div>
                </div>
            </article>
        <?php endforeach; ?>
    </div>

    <?= $this->pagination ?>

    <?php if ($this->canReply): ?>
        <section class="synapsis-reply" id="synapsis-reply">
            <h3 class="synapsis-reply__title"><?= $GLOBALS['TL_LANG']['MSC']['synapsisReply'] ?? 'Antworten' ?></h3>

            <?php if (!empty($this->formError)): ?>
                <p class="synapsis-formerror"><?= $this->formError ?></p>
            <?php endif; ?>

            <form action="<?= $this->formAction ?>" method="post" enctype="multipart/form-data" class="synapsis-form">
                <input type="hidden" name="FORM_SUBMIT" value="<?= $this->formId ?>">
                <input type="hidden" name="REQUEST_TOKEN" value="<?= $requestToken ?>">
                <?php if (!empty($this->quotePost)): ?><input type="hidden" name="quote_post" value="<?= (int) $this->quotePost ?>"><?php endif; ?>

                <textarea name="text" class="<?= $this->editor ? 'synapsis-editor' : '' ?>" rows="8"<?php if (!empty($this->draftKey)): ?> data-draft data-draft-key="<?= $this->draftKey ?>"<?php endif; ?>><?= StringUtil::specialchars($this->replyPrefill) ?></textarea>

                <?php if (!empty($this->emoticons)): ?>
                    <div class="synapsis-smileys">
                        <?php foreach ($this->emoticons as $emo): ?><button type="button" class="synapsis-smiley" data-emoji="<?= $emo ?>" title="Smiley einfügen"><?= $emo ?></button><?php endforeach; ?>
                    </div>
                <?php endif; ?>

                <?php if ($this->allowUploads): ?>
                    <label class="synapsis-form__upload">
                        <span><?= $GLOBALS['TL_LANG']['MSC']['synapsisAttachment'] ?? 'Dateianhänge' ?></span>
                        <input type="file" name="attachment[]" multiple>
                    </label>
                <?php endif; ?>

                <button type="submit" class="synapsis-button synapsis-button--primary"><?= $GLOBALS['TL_LANG']['MSC']['synapsisSubmitReply'] ?? 'Antwort absenden' ?></button>
            </form>
        </section>
    <?php elseif ($this->locked): ?>
        <p class="synapsis-note"><?= $GLOBALS['TL_LANG']['MSC']['synapsisLockedNote'] ?? 'Dieses Thema ist geschlossen. Es sind keine Antworten mehr möglich.' ?></p>
    <?php elseif (!empty($this->isBanned)): ?>
        <p class="synapsis-note synapsis-note--banned"><?= $GLOBALS['TL_LANG']['MSC']['synapsisBannedNote'] ?? 'Du bist für das Forum gesperrt und kannst keine Beiträge verfassen.' ?></p>
    <?php elseif (!$this->loggedIn): ?>
        <p class="synapsis-note"><?= $GLOBALS['TL_LANG']['MSC']['synapsisLoginNote'] ?? 'Bitte melden Sie sich an, um zu antworten.' ?></p>
    <?php endif; ?>

    <p class="synapsis-back"><a href="<?= $this->forum['id'] ? $this->baseUrl . '?forum=' . $this->forum['id'] : $this->baseUrl ?>">&laquo; <?= $GLOBALS['TL_LANG']['MSC']['synapsisBackToTopics'] ?? 'Zurück zum Forum' ?></a></p>

    <?php $this->insert('mod_synapsis_membernav', $this->getData()); ?>

    <div class="synapsis-lightbox" hidden><span class="synapsis-lightbox__close" aria-hidden="true">&times;</span><img src="" alt=""></div>

    <script>
    (function(){
        // Dokumentweite Delegation statt Bindung an das umgebende Element:
        // funktioniert auch, wenn das Website-Theme Skripte verschiebt oder
        // buendelt (document.currentScript waere dann nicht verlaesslich).
        if (window.synapsisTopicInit) return;
        window.synapsisTopicInit = true;

        // Permalink in die Zwischenablage kopieren (Fallback: normal folgen)
        document.addEventListener('click', function(e){
            var a = e.target.closest('.synapsis [data-permalink]');
            if (!a || !navigator.clipboard) return;
            e.preventDefault();
            navigator.clipboard.writeText(a.href).then(function(){
                var t = a.textContent;
                a.textContent = <?= json_encode($GLOBALS['TL_LANG']['MSC']['synapsisPermalinkCopied'] ?? 'Kopiert!') ?>;
                setTimeout(function(){ a.textContent = t; }, 1200);
            });
        });

        // Bild-Lightbox fuer Bildanhaenge: oeffnet das Original im Overlay
        // (statt Navigation zur Bilddatei); Schliessen per Klick oder Escape.
        document.addEventListener('click', function(e){
            var link = e.target.closest('.synapsis-attachment--image');
            var box = document.querySelector('.synapsis-lightbox');
            if (!link || !box) return;
            e.preventDefault();
            box.querySelector('img').src = link.getAttribute('href');
            box.hidden = false;
        });
        document.addEventListener('click', function(e){
            var box = e.target.closest('.synapsis-lightbox');
            if (box) { box.hidden = true; box.querySelector('img').src = ''; }
        });
        document.addEventListener('keydown', function(e){
            if (e.key !== 'Escape') return;
            var box = document.querySelector('.synapsis-lightbox');
            if (box && !box.hidden) { box.hidden = true; box.querySelector('img').src = ''; }
        });
    })();
    </script>

</div>
